{
    "name": "kabochan73/er-generate",
    "description": "Generate Mermaid ER diagrams from Laravel migration files",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "kabochan73"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Kabochan73\\ErGenerate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kabochan73\\ErGenerate\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kabochan73\\ErGenerate\\ErGenerateServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
